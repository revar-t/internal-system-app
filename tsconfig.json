{
  "compilerOptions": {
    /* ===== 基本設定 ===== */
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler", // ← これがVite推奨！
    "jsx": "react-jsx",
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,

    /* ===== 型補完 ===== */
    "types": ["vite/client"], // Vite の import.meta 環境用

    /* ===== 出力関連 ===== */
    "sourceMap": true,
    "declaration": false, // React UI用途なら不要
    "declarationMap": false,

    /* ===== 拡張オプション ===== */
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noUncheckedSideEffectImports": true,

  },

  /* ===== コンパイル対象 ===== */
  "include": ["resources/ts"],
  "exclude": ["node_modules", "vendor"]
}
